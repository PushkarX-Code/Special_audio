{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Special Audio",
  "version": "0.8.2",
  "identifier": "io.github.pushkarxcode.specialaudio",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Special Audio",
        "width": 1120,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "label": "main"
      },
      {
        "label": "mini",
        "url": "mini.html",
        "title": "Special Audio",
        "width": 340,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Unofficial companion for the CMF Headphone Pro",
    "longDescription": "Unofficial desktop companion for the CMF Headphone Pro. Not affiliated with Nothing Technology Ltd.",
    "copyright": "MIT License, Pushkar Choudhury",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2QjU5MjQzQTk0NDJFOEEKUldTS0xrU3BRNUsxQmdwWFJFVlZRM1g4dlFTcEY0c0tJUGl0Q2JxZGZTem95N2IycUV2bTZzS3EK",
      "endpoints": [
        "https://github.com/PushkarX-Code/Special_audio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
