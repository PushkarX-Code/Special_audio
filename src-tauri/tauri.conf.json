{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Special Audio",
  "version": "0.1.2",
  "identifier": "io.github.pushkarxcode.specialaudio",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "Special Audio",
        "width": 1120,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Unofficial companion for the CMF Headphone Pro",
    "longDescription": "Unofficial desktop companion for the CMF Headphone Pro. Not affiliated with Nothing Technology Ltd.",
    "copyright": "MIT License, Pushkar Choudhury",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
